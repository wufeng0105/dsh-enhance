# runtime state written under <DSH_HOME>/enhance — never part of this repo
state.json
install-manifest.json

# install/uninstall backups of cordis.patch.yml
*.bak-*

# 依赖与打包产物：本地跑一次 npm install 或 npm pack 就会产生。
# 这几个不忽略会直接挡住 release.mjs 的「工作区必须干净」前置条件，
# 让人误以为仓库脏了。
node_modules/
package-lock.json
*.tgz

# OS / editor
.DS_Store
Thumbs.db
desktop.ini

# local design previews (not part of the repo); anchored so a tracked design/ still works
/design/

# Archify deliverables: interactive HTML + receipts. The publishable figures are
# extracted into docs/figures/ and tracked; these are the build byproducts.
/.archify/

# local code index (codegraph cli), machine-specific
.codegraph/

# local clone of upstream ZCode source, not part of this repo
/ZCode/

# scratch files from local exploration sessions
.tmp/

# zhll draft area
.zhll/

# DSH project-local skills / runtime state (installed copies, never part of the repo)
.dsh/
