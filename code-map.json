{
  "version": 1,
  "layers": [
    "cli",
    "core",
    "plugin"
  ],
  "modules": [
    {
      "id": "packaging.root-entry",
      "layer": "core",
      "path": "index.js",
      "owns": "包根入口的占位——只为满足市场插件的装后校验（上游 dsh-market/dsh-market#1091），宿主从不加载它（bundle 只加载 patch 行所指的模块）。拆除条件见 index.js 顶部注释与 check.mjs 的 gateBundle 里那段判定"
    },
    {
      "id": "core.state",
      "layer": "core",
      "path": "shared/state.mjs",
      "owns": "state.json 与 content-scope.txt / identity.txt 的读写、派生（含品牌人设三态）"
    },
    {
      "id": "plugin.scope",
      "layer": "plugin",
      "path": "enhance-scope/index.js",
      "owns": "内容边界注入 + 品牌人设（按 agent 遮蔽宿主同名段与 context，含安装状态 identityInstall 与 identityShadowProof 遮蔽回验）+ /enhance/api 路由（state / set / check / preset）+ 本机版本探测（只读 app.asar 清单）"
    },
    {
      "id": "plugin.approve",
      "layer": "plugin",
      "path": "auto-approve/index.js",
      "owns": "审批三态应答（allow / ask / deny）"
    },
    {
      "id": "core.session-probe",
      "layer": "core",
      "path": "shared/session-probe.mjs",
      "owns": "会话日志探针：正向证明边界/人设文本真的进了系统提示（sessionContains），反向证明宿主原句真的被顶掉（sessionOmits）"
    },
    {
      "id": "plugin.ui",
      "layer": "plugin",
      "path": "ui/index.js",
      "owns": "设置页壳：宿主半（空）"
    },
    {
      "id": "plugin.ui-client",
      "layer": "plugin",
      "path": "ui/client.js",
      "owns": "设置页：浏览器半，五组设置（品牌人设 / 内容边界 / 越界审批 / Enhanced 权限档 / 检查）+ 就地错误行，注册 settings.section 并调 /enhance/api"
    },
    {
      "id": "tool.docs-check",
      "layer": "cli",
      "path": "tools/docs-check.mjs",
      "owns": "文档门禁：字面转义 / 死链 / 死路径（收集 README + CHANGELOG + CONTRIBUTING + docs/**；根文档缺一份也判红）"
    },
    {
      "id": "tool.asar-read",
      "layer": "cli",
      "path": "tools/asar-read.mjs",
      "owns": "asar 只读读取器（零依赖）：解析头、列条目、按路径取字节；宿主原文核对共用这一份实现"
    },
    {
      "id": "tool.host-check",
      "layer": "cli",
      "path": "tools/host-check.mjs",
      "owns": "宿主原文基准核对：只读 asar，查 harness:identity 座位、HOST_IDENTITY_SENTENCE 逐字命中、harness:source / app:web-surface 的 section+context 成对；没有 asar 如实跳过，坏 asar 判红"
    },
    {
      "id": "tool.counts-check",
      "layer": "cli",
      "path": "tools/counts-check.mjs",
      "owns": "文档计数一致性：读 scripts/known-counts.json 单一来源，扫文档里的测试/负例/检查项/断言/组数/触点声明；生产事实（设置组数）先自证，历史核验记录不按现值校验；`--report` 只读列出每一处声明位清单，不改判定"
    },
    {
      "id": "tool.field-check",
      "layer": "cli",
      "path": "tools/field-check.mjs",
      "owns": "未文档化宿主字段禁令：生产代码里出现 layers / *.layers / layers.* 入口即红，除非登记在 scripts/host-fields-allowlist.json；目录缺失或扫不到文件也判红"
    },
    {
      "id": "tool.contacts-count",
      "layer": "cli",
      "path": "tools/contacts-count.mjs",
      "owns": "宿主触点数的机器来源：按 docs/compatibility.md「宿主触点」节的口径现场数（分组表第二列按「、」分段、版本探测链按 → 拆），与 known-counts.json 的 hostContacts 对账；表读不出来判红"
    },
    {
      "id": "tool.smoke",
      "layer": "cli",
      "path": "tools/smoke.mjs",
      "owns": "端到端冒烟：隔离 home 真装 bundle、组合树、三态、品牌人设遮蔽项、写档/摘档后宿主重新组合"
    },
    {
      "id": "tool.compat-diff",
      "layer": "cli",
      "path": "tools/compat-diff.mjs",
      "owns": "例行核验第 2/3 步工具化：blobless 缓存上列 9 包变更（changed-files 行）、逐文件统一 diff 落盘、按 compatibility.md 第 1a 步表格的 8 组接缝表达式预分类（SEAM-HIT/SKIM，--dsw-/--ds- 前缀去重）、--trees 逐包 tree SHA 表（全程零网络）；预分类是分诊不是判决，SKIM 不等于免检"
    },
    {
      "id": "core.text-lines",
      "layer": "core",
      "path": "shared/text-lines.mjs",
      "owns": "换行安全与按行切拼"
    },
    {
      "id": "core.preset-shape",
      "layer": "core",
      "path": "shared/preset-shape.mjs",
      "owns": "从 profile patch 读默认档位与 approval（首装审批种子用）"
    },
    {
      "id": "core.preset",
      "layer": "core",
      "path": "shared/preset.mjs",
      "owns": "写/摘 enhanced 权限档：块与 flow 两种形态的安全改写、归属记录、不猜"
    },
    {
      "id": "tool.code-files",
      "layer": "cli",
      "path": "scripts/code-files.mjs",
      "owns": "语法门禁的文件集合：git ls-files 优先，无 git 时走盘并跳过忽略目录"
    },
    {
      "id": "tool.repo-copy",
      "layer": "cli",
      "path": "scripts/repo-copy.mjs",
      "owns": "门禁自检的仓库副本：跳过被 .gitignore 排除的本地件（ZCode 有 3 GB / 3.6 万文件）"
    },
    {
      "id": "core.seed",
      "layer": "core",
      "path": "shared/seed.mjs",
      "owns": "首装种子：审批档位规则 + <home>/enhance 目录的幂等补齐（没有安装器阶段，apply() 时补齐）"
    }
  ],
  "edges": [
    {
      "from": "plugin.scope",
      "to": "core.state",
      "kind": "import"
    },
    {
      "from": "plugin.approve",
      "to": "core.state",
      "kind": "import"
    },
    {
      "from": "plugin.scope",
      "to": "host.systemPrompt",
      "kind": "seam",
      "via": "ctx.systemPrompt.section()"
    },
    {
      "from": "plugin.scope",
      "to": "host.webServer",
      "kind": "seam",
      "via": "ctx.inject(['webServer']) → register"
    },
    {
      "from": "plugin.approve",
      "to": "host.approval",
      "kind": "seam",
      "via": "ctx.on('approval/request')"
    },
    {
      "from": "tool.smoke",
      "to": "host.webServer",
      "kind": "seam",
      "via": "冒烟里用假 ctx 捕获 webServer.register 拿到真实 handler"
    },
    {
      "from": "plugin.scope",
      "to": "core.session-probe",
      "kind": "import"
    },
    {
      "from": "core.seed",
      "to": "core.state",
      "kind": "import"
    },
    {
      "from": "core.seed",
      "to": "core.preset-shape",
      "kind": "import"
    },
    {
      "from": "core.preset",
      "to": "core.text-lines",
      "kind": "import"
    },
    {
      "from": "core.preset",
      "to": "core.state",
      "kind": "import"
    },
    {
      "from": "plugin.scope",
      "to": "core.seed",
      "kind": "import"
    },
    {
      "from": "plugin.scope",
      "to": "core.preset",
      "kind": "import"
    },
    {
      "from": "plugin.approve",
      "to": "core.seed",
      "kind": "import"
    },
    {
      "from": "plugin.scope",
      "to": "host.agentScope",
      "kind": "seam",
      "via": "ctx.on('agent/created') → agent.ctx.inject(['systemPrompt']) → 按名遮蔽 harness:identity / harness:source / app:web-surface"
    },
    {
      "from": "tool.host-check",
      "to": "tool.asar-read",
      "kind": "import"
    }
  ],
  "events": [
    {
      "name": "approval/request",
      "mode": "waterfall",
      "owner": "plugin.approve"
    },
    {
      "name": "agent/created",
      "mode": "serial",
      "owner": "plugin.scope"
    },
    {
      "name": "agent/disposed",
      "mode": "emit",
      "owner": "plugin.scope"
    }
  ],
  "state": {
    "fields": [
      "version",
      "enabled",
      "contentScope",
      "approval",
      "identity",
      "hideHarness",
      "updatedAt"
    ],
    "derived": [
      "injecting",
      "identityEffective",
      "identityInstall"
    ],
    "pluginScoped": [
      "active"
    ]
  }
}