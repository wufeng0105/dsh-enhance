root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# 设置页的浏览器半整份用制表符
[ui/client.js]
indent_style = tab

# 与 .gitattributes 的 *.ps1 text eol=crlf 保持一致
[*.ps1]
end_of_line = crlf
